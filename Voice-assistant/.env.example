# Copy to .env next to package.json. Every setting is optional.
PORT=3000

# HTTPS for tablets on the restaurant's network (browsers only allow the microphone on secure pages).
# A certificate is created on first start; each tablet installs it once from /tablet-setup.
# HTTPS=off turns this off. Set both TLS_ files to use a certificate of your own for a real domain.
HTTPS_PORT=3443
HTTPS=
TLS_CERT_FILE=
TLS_KEY_FILE=

# Restaurant licence, managed from the admin app (../Admin). Use the same Supabase project's URL and
# anon (public) key. Never put the service role key here. Leave both unset to run standalone.
# A paid restaurant keeps working while the internet is down, until its plan's end date.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Standalone only (ignored when licensed: the name and 6-digit PIN come from the admin app).
RESTAURANT_NAME=
STAFF_PIN=

# Nightly database backups. BACKUP_COPY_DIR adds a second copy, e.g. a USB drive or a synced folder.
BACKUP_DIR=
BACKUP_COPY_DIR=
BACKUP_KEEP=14
BACKUP_HOUR=3

# Speech recognition. The default multilingual model understands Hindi and Marathi as well as
# English; small.en is English-only.
WHISPER_MODEL=small

# The assistant's voice, made locally by Voicebox (see the README). engine:voice, for example
# kokoro:af_bella or qwen_custom_voice:Serena. VOICEBOX_SPEED 0.93 is about 160 words a minute.
VOICEBOX_PRESET=kokoro:af_heart
VOICEBOX_SPEED=0.93
