# Copy to .env next to package.json. Every setting is optional.
PORT=3000

# Restaurant licence, managed from the admin app (../Admin). Use the same Supabase project's URL and
# anon (public) key. Never put the service role key here. Leave both unset to run standalone.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# How long to keep serving on the last known status if Supabase can't be reached.
LICENSE_GRACE_MINUTES=15

# Standalone only (ignored when licensed: the name and 6-digit PIN come from the admin app).
RESTAURANT_NAME=
STAFF_PIN=
