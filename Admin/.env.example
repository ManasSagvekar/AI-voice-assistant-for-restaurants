# Copy to .env.local. The service role key must never reach the browser: only server code reads it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where restaurants can reach this app, for the set-password links in their emails. While this is
# localhost, links only work on this computer, so they are shown to you instead of being emailed.
ADMIN_PUBLIC_URL=https://admin.yourdomain.com/admin
# 2-step sign-in for admins is off for now. Set to on to require a code from an authenticator app
# (TOTP must be enabled in Supabase); for a lost phone, use npm run reset-admin-2fa.
ADMIN_2FA=

# Welcome emails via Resend (https://resend.com). Without a key, details are shown on screen instead.
RESEND_API_KEY=
EMAIL_FROM=Restaurant Services <onboarding@yourdomain.com>

# Optional: the address restaurants open for their dashboard, included in emails.
VOICE_ASSISTANT_URL=http://localhost:3000/restaurant

# Razorpay billing (optional). Payment links are created for one plan period at these prices, in
# rupees; the webhook marks the restaurant paid and extends its plan when Razorpay confirms payment.
# Webhook URL: https://<this host>/admin/api/razorpay/webhook
# Events: payment_link.paid, subscription.charged, subscription.pending, subscription.halted
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRICE_MONTHLY=
RAZORPAY_PRICE_3_MONTH=
RAZORPAY_PRICE_6_MONTH=
RAZORPAY_PRICE_YEARLY=
BILLING_CURRENCY=INR

# Daily plan-end reminders: GET /admin/api/cron/reminders with "Authorization: Bearer <CRON_SECRET>".
# On Vercel, vercel.json schedules it and sends the header for you.
CRON_SECRET=
