# Copy to .env.local. The service role key must never reach the browser: only server code reads it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Welcome emails via Resend (https://resend.com). Without a key, credentials are shown on screen instead.
RESEND_API_KEY=
EMAIL_FROM=Restaurant Services <onboarding@yourdomain.com>

# Optional: the address restaurants open for their dashboard, included in emails.
VOICE_ASSISTANT_URL=http://localhost:3000/restaurant
